---
import Layout from "../../layouts/Layout.astro";
import Playground from "../../components/Playground.astro";
import AsciiDocLiveDemo from "../../components/AsciiDocLiveDemo.astro";
import { link } from "../../lib/link";
import "../../styles/global.css";
---

<Layout
  locale="en"
  lang="en"
  title="DocGist — AsciiDoc, the document format that works best with AI"
  description="AsciiDoc is a document format with high affinity for AI agents. DocGist explains why and how to use it."
>
  <section class="hero">
    <div class="wrap">
      <span class="kicker">AsciiDoc for humans & AI</span>
      <h1>
        The document format<br />
        that <em class="hl">gets along</em><br />
        with AI agents
      </h1>
      <p class="lead">
        AsciiDoc (.adoc) is an explicit, structured format that stays stable even
        when AI writes it. Learn it here — with a live playground.
      </p>
      <div class="cta-row">
        <a class="btn btn-accent" href={link("/en/what-is-asciidoc")}>Learn AsciiDoc</a>
        <a class="btn btn-paper" href={link("/en/playground")}>Try the Playground</a>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="section-title">What is .adoc?</h2>
    <div class="def">
      <p>
        <span class="ext">.adoc</span>
        is the file extension of <strong>AsciiDoc</strong>, a
        <strong>lightweight markup language</strong> that expresses document
        structure as plain text. Syntax such as <code>= heading</code>,
        <code>[NOTE]</code> and <code>|===</code> lets you write headings,
        admonitions, tables and code blocks directly in a text file.
      </p>
      <p>
        The <code>.adoc</code> extension simply means "an AsciiDoc document".
        Because it is plain text, it opens in any editor and fits naturally into
        Git-based diffing and version control.
      </p>
    </div>

    <div class="grid">
      <div class="card">
        <div class="icon">📝</div>
        <h3>Plain text</h3>
        <p>No special tools required. Read it anywhere and diff or manage it with Git.</p>
      </div>
      <div class="card">
        <div class="icon">🧱</div>
        <h3>Explicit structure</h3>
        <p>Heading levels, tables and notes are unambiguous syntax — no space-wrapping ambiguity.</p>
      </div>
      <div class="card">
        <div class="icon">⚙️</div>
        <h3>Deterministic output</h3>
        <p>asciidoctor turns the same input into the same HTML, so AI output can be verified automatically.</p>
      </div>
    </div>
    <p style="margin-top: 1.6rem">
      <a class="btn btn-paper" href={link("/en/what-is-asciidoc")}>See the grammar in detail →</a>
    </p>
  </section>

  <section class="wrap section">
    <h2 class="section-title">Structure at a glance</h2>
    <p style="max-width: 44rem">
      Unlike space-sensitive Markdown, AsciiDoc makes <strong>headings,
      admonitions and tables explicit syntax</strong>. AI output stays stable
      through conversion — friendly to both humans and machines.
      Edit the left pane and watch the converted HTML update in real time.
    </p>
    <AsciiDocLiveDemo
      sourceLabel="AsciiDoc source"
      outputLabel="Converted output"
      noteTitle="Why Monaco? About this editor"
      note="It uses the same Monaco Editor as VS Code — full-featured editing with syntax highlighting and completion, right in the browser. Perfect for validating .adoc written by AI."
      cheatTitle=".adoc syntax cheat sheet"
      cheatItems={[
        {
          name: "Headings",
          sample: "= Document Title\n== Section\n=== Subsection",
          desc: "More `=` marks a deeper heading",
        },
        {
          name: "Emphasis",
          sample: "*bold* and _italic_ and `code`",
          desc: "Inline styles written in place",
        },
        {
          name: "Lists",
          sample: "* unordered\n. ordered",
          desc: "Nest by indenting",
        },
        {
          name: "Admonition",
          sample: "[NOTE]\n====\nImportant info here\n====",
          desc: "NOTE / TIP / WARNING / IMPORTANT / CAUTION",
        },
        {
          name: "Table",
          sample: "|===\n|A |B\n\n|1 |2\n|===",
          desc: "CSV-like table syntax",
        },
        {
          name: "Code block",
          sample: "[source,js]\n----\nconsole.log('hi')\n----",
          desc: "Language-tagged with highlighting",
        },
        {
          name: "Link",
          sample: "https://asciidoctor.org is a reference",
          desc: "URLs become links automatically",
        },
      ]}
      sample={`= A doc easy for AI to write

Because structure is explicit, AI reliably produces valid AsciiDoc.

[NOTE]
AI agents output into .adoc structure smoothly.

== Explicit headings

[source,bash]
$ asciidoctor my-doc.adoc
`}
    />
  </section>

  <section class="wrap section">
    <h2 class="section-title">Try it in your browser</h2>
    <Playground
      heading="Write AsciiDoc, convert instantly"
      lead="Write .adoc on the left and the HTML renders on the right in real time. Try it here to feel why the structure is explicit."
      btnCopy="Copy"
      btnClear="Clear"
      copiedLabel="Copied!"
      sourceLabel="AsciiDoc source"
      outputLabel="Converted output"
    />
  </section>

  <section class="wrap section">
    <h2 class="section-title">Why AsciiDoc wins with AI</h2>
    <div class="grid">
      <div class="card card-a">
        <div class="icon">🗼</div>
        <h3>Explicit structure</h3>
        <p>Headings, tables and notes are part of the syntax — no space-wrapping ambiguity.</p>
      </div>
      <div class="card card-b">
        <div class="icon">⚙️</div>
        <h3>Deterministic conversion</h3>
        <p>asciidoctor converts to HTML deterministically, so AI output → build → verify can be automated.</p>
      </div>
      <div class="card card-c">
        <div class="icon">📦</div>
        <h3>One source, many outputs</h3>
        <p>A single .adoc renders to HTML, PDF and slides (Reveal.js) consistently.</p>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="section-title">AsciiDoc vs Markdown</h2>
    <table class="table">
      <thead>
        <tr>
          <th>Aspect</th>
          <th>AsciiDoc</th>
          <th>Typical Markdown pitfalls</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Structure</td>
          <td class="yes">Explicit syntax</td>
          <td>Space/indent ambiguity</td>
        </tr>
        <tr>
          <td>Determinism</td>
          <td class="yes">Reproducible output</td>
          <td>Results vary across dialects</td>
        </tr>
        <tr>
          <td>Outputs</td>
          <td class="yes">HTML / PDF / slides</td>
          <td class="no">Depends on extensions</td>
        </tr>
      </tbody>
    </table>
  </section>

  <section class="wrap section">
    <h2 class="section-title">Invisible characters & .adoc</h2>
    <p style="max-width: 44rem">
      .adoc treats <strong>invisible characters</strong> (non-printing Unicode codepoints)
      as literal content. Asciidoctor keeps them in the converted HTML, which can be
      abused for technical tampering: text that <em>looks safe</em> but secretly contains
      something else (hidden instructions, altered identifiers, spoofed URLs).
    </p>

    <div class="def">
      <p>
        The most common invisible characters are listed below. They are nearly invisible
        in an editor, but fully visible to programs:
      </p>
    </div>

    <table class="table">
      <thead>
        <tr>
          <th>Codepoint</th>
          <th>Name</th>
          <th>Abuse example</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="mono">U+200B</td>
          <td>Zero-width space (ZWS)</td>
          <td>Split names, URLs or code without changing how it looks</td>
        </tr>
        <tr>
          <td class="mono">U+200C / U+200D</td>
          <td>ZWNJ / ZWJ</td>
          <td>Bypass string matching with near-identical text</td>
        </tr>
        <tr>
          <td class="mono">U+202E etc.</td>
          <td>Bidi override (RLO etc.)</td>
          <td>Flip display order to disguise strings, filenames and URLs</td>
        </tr>
        <tr>
          <td class="mono">U+FEFF</td>
          <td>BOM / ZW non-breaking space</td>
          <td>Hiding at the start to break checks and comparisons</td>
        </tr>
        <tr>
          <td class="mono">U+2060</td>
          <td>Word joiner (WJ)</td>
          <td>Spoofing line-break and layout behavior</td>
        </tr>
      </tbody>
    </table>

    <div class="def">
      <p>
        <strong>Principle</strong>: conversion is <em>faithful preservation</em>, not
        quarantine. When adopting an untrusted .adoc, run an
        <span class="mono">invisible-character scan</span> and
        <span class="mono">normalization</span> first (e.g. detect/remove
        <code>[\u200B-\u200D\u2060\uFEFF\u202A-\u202E]</code>).
      </p>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="section-title">Grab a template</h2>
    <p style="max-width: 44rem">
      Ready-to-use .adoc templates — just replace the
      <code>&#123;&#123; placeholders &#125;&#125;</code>.
      When you ask AI to write, keeping this structure keeps the output stable.
    </p>
    <div class="grid">
      <div class="card">
        <div class="icon">📄</div>
        <h3>Generic document</h3>
        <p>Classic background / overview / details / summary structure. Great for notes and docs.</p>
        <p class="card-actions">
          <a class="btn btn-accent" href={link("/templates/en/document.adoc")} download>Get the .adoc</a>
        </p>
      </div>
      <div class="card">
        <div class="icon">🧩</div>
        <h3>Feature spec / PRD</h3>
        <p>Goals, user stories and acceptance criteria — ideal for spec work with AI.</p>
        <p class="card-actions">
          <a class="btn btn-accent" href={link("/templates/en/spec.adoc")} download>Get the .adoc</a>
        </p>
      </div>
      <div class="card">
        <div class="icon">📝</div>
        <h3>Meeting notes</h3>
        <p>Date, attendees, agenda, decisions and follow-ups in clean tables and notes.</p>
        <p class="card-actions">
          <a class="btn btn-accent" href={link("/templates/en/meeting-notes.adoc")} download>Get the .adoc</a>
        </p>
      </div>
      <div class="card">
        <div class="icon">🚀</div>
        <h3>Release notes</h3>
        <p>New features, changes and known issues — readable by customers and AI alike.</p>
        <p class="card-actions">
          <a class="btn btn-accent" href={link("/templates/en/release-notes.adoc")} download>Get the .adoc</a>
        </p>
      </div>
    </div>
    <p style="margin-top: 1.4rem; font-size: 0.9rem; color: #555">
      Tip: paste the template into the Playground to preview its output before you publish. <a href={link("/playground")}>Open the Playground →</a>
    </p>
  </section>

  <section class="wrap section">
    <h2 class="section-title">Get started</h2>
    <ol class="steps">
      <li>Open the Playground and write .adoc on the left.</li>
      <li>Watch the rendered HTML update in real time on the right.</li>
      <li>Check the grammar in "What is AsciiDoc".</li>
    </ol>
    <p style="margin-top: 2rem">
      <a class="btn btn-paper" href={link("/en/playground")}>Open the Playground →</a>
    </p>
  </section>
</Layout>