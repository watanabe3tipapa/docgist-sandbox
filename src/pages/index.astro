---
import Layout from "../layouts/Layout.astro";
import Playground from "../components/Playground.astro";
import AsciiDocLiveDemo from "../components/AsciiDocLiveDemo.astro";
import { link } from "../lib/link";
import "../styles/global.css";
---

<Layout
  locale="ja"
  lang="ja"
  title="DocGist — 生成AIに最適なドキュメント形式 AsciiDoc"
  description="AsciiDoc は生成AIとの親和性が高い文書形式です。DocGist がその理由と活用法を解説します。"
>
  <section class="hero">
    <div class="wrap">
      <span class="kicker">AsciiDoc for humans & AI</span>
      <h1>
        生成AI と<br />
        いちばん<em class="hl">相性のいい</em><br />
        文書形式
      </h1>
      <p class="lead">
        AsciiDoc(.adoc)は構造が明示的で、AI が書いても安定して出力する文書形式。
        解説・プレイグラウンド付きで学べます。
      </p>
      <div class="cta-row">
        <a class="btn btn-accent" href={link("/what-is-asciidoc")}>AsciiDoc を学ぶ</a>
        <a class="btn btn-paper" href={link("/playground")}>Playground で試す</a>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="section-title">.adoc とは?</h2>
    <div class="def">
      <p>
        <span class="ext">.adoc</span>
        <strong>AsciiDoc</strong> の拡張子で、文書の構造をテキストで明示できる
        <strong>軽量マークアップ言語</strong>です。`= 見出し`・`[NOTE]`・`|===` のような
        構文をプレーンテキストに埋め込むだけで、見出し・注意書き・テーブル・コードブロックを表現できます。
      </p>
      <p>
        拡張子が <code>.adoc</code> なのは「AsciiDoc の文書」という意味。ただのテキストなので、
        どんなエディタでも開け、Git での diff やバージョン管理にも自然に馴染みます。
      </p>
    </div>

    <div class="grid">
      <div class="card">
        <div class="icon">📝</div>
        <h3>プレーンテキスト</h3>
        <p>専用ツール不要。メモ帳やブラウザでも読めて、diff・Git 管理がしやすい。</p>
      </div>
      <div class="card">
        <div class="icon">🧱</div>
        <h3>明示的な構造</h3>
        <p>見出しレベル・テーブル・NOTE が構文として一意。余白依存の曖昧さがありません。</p>
      </div>
      <div class="card">
        <div class="icon">⚙️</div>
        <h3>決定的に変換</h3>
        <p>asciidoctor が同じ入力から同じ HTML を生成。AI 出力の検証を自動化できます。</p>
      </div>
    </div>
    <p style="margin-top: 1.6rem">
      <a class="btn btn-paper" href={link("/what-is-asciidoc")}>文法を詳しく見る →</a>
    </p>
  </section>

  <section class="wrap section">
    <h2 class="section-title">ひと目でわかる構造</h2>
    <p style="max-width: 44rem">
      AsciiDoc は余白依存の Markdown と違い、<strong>見出し・アドモニション・テーブルが構文として明示的</strong>です。
      そのため AI が出力した文章も安定して変換され、人と機械の両方に優しい文書になります。
      左のエディタを書き換えると、変換結果がリアルタイムに変わります。
    </p>
    <AsciiDocLiveDemo
      sourceLabel="AsciiDoc ソース"
      outputLabel="変換結果"
      noteTitle="Why Monaco? このエディタについて"
      note="VS Code と同じ Monaco Editor を採用しています。シンタックスハイライト・補完など本格的な編集体験をブラウザでそのまま再現でき、AI が書いた .adoc の検証にも最適です。"
      cheatTitle=".adoc 記法チートシート"
      cheatItems={[
        {
          name: "見出し",
          sample: "= 文書タイトル\n== セクション\n=== サブセクション",
          desc: "`=` が多いほど下位の見出し",
        },
        {
          name: "強調",
          sample: "*太字* と _強調_ と `等幅`",
          desc: "インラインでそのまま書ける",
        },
        {
          name: "リスト",
          sample: "* 箇条書き\n. 番号付き",
          desc: "入れ子はインデントで表現",
        },
        {
          name: "アドモニション",
          sample: "[NOTE]\n====\n注意・補足はここ\n====",
          desc: "NOTE / TIP / WARNING / IMPORTANT / CAUTION",
        },
        {
          name: "テーブル",
          sample: "|===\n|A |B\n\n|1 |2\n|===",
          desc: "CSV ライクで書ける",
        },
        {
          name: "コードブロック",
          sample: "[source,js]\n----\nconsole.log('hi')\n----",
          desc: "言語付きでシンタックスハイライト",
        },
        {
          name: "リンク",
          sample: "https://asciidoctor.org は参考書",
          desc: "URL もメールアドレスもそのままリンクになる",
        },
      ]}
      sample={`= AI に書かせやすい文章

AsciiDoc は構造が明示的, AI が書いても安定して変換されます。

[NOTE]
生成 AI は .adoc の構造構文へ安定して出力できます。

== 見出しも明示的

[source,bash]
$ asciidoctor my-doc.adoc
`}
    />
  </section>

  <section class="wrap section">
    <h2 class="section-title">ブラウザで試す</h2>
    <Playground
      heading="AsciiDoc を書いて、すぐに変換"
      lead="左に .adoc を書くと右へ即時に HTML 変換されます。ここで試せば、構造が明示的な理由が体感できます。"
      btnCopy="コピー"
      btnClear="クリア"
      copiedLabel="コピーしました"
      sourceLabel="AsciiDoc ソース"
      outputLabel="変換結果"
    />
  </section>

  <section class="wrap section">
    <h2 class="section-title">AsciiDoc が AI と相性がいい理由</h2>
    <div class="grid">
      <div class="card card-a">
        <div class="icon">🗼</div>
        <h3>明示的な構造</h3>
        <p>見出し・テーブル・NOTE が構文として明確。Markdown の余白依存の曖昧さがありません。</p>
      </div>
      <div class="card card-b">
        <div class="icon">⚙️</div>
        <h3>決定的変換</h3>
        <p>asciidoctor が決定的に HTML へ変換。AI 出力 → ビルド → 検証の自動化ができます。</p>
      </div>
      <div class="card card-c">
        <div class="icon">📦</div>
        <h3>1 ソース多展開</h3>
        <p>.adoc 1 つから HTML / PDF / スライド(Reveal.js)を一律に生成できます。</p>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="section-title">Markdown との比較</h2>
    <table class="table">
      <thead>
        <tr>
          <th>観点</th>
          <th>AsciiDoc</th>
          <th>Markdown の典型的な課題</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>構造表現</td>
          <td class="yes">構文で明示</td>
          <td>余白・記号の依存で曖昧</td>
        </tr>
        <tr>
          <td>変換の決定性</td>
          <td class="yes">決定論的で再現性あり</td>
          <td>方言 (dialects) で結果が変わる</td>
        </tr>
        <tr>
          <td>展開先</td>
          <td class="yes">HTML / PDF / スライド</td>
          <td class="no">拡張に依存</td>
        </tr>
      </tbody>
    </table>
  </section>

  <section class="wrap section">
    <h2 class="section-title">不可視文字と .adoc</h2>
    <p style="max-width: 44rem">
      .adoc は表示に影響しない「不可視文字」をそのまま本文として扱います。
      Asciidoctor による変換後も消えずに HTML へ残るため、見た目と中身の不一致(<strong>見た目は安全、実体は別の指示</strong>)を生み出すテクニカルな改ざんに使えます。
    </p>

    <div class="def">
      <p>
        <strong>主な不可視文字</strong>は次の通りです。どこに埋め込まれていても、テキストエディタの画面では
        ほぼ見えません(プログラムには見えています)。
      </p>
    </div>

    <table class="table">
      <thead>
        <tr>
          <th>コードポイント</th>
          <th>名称</th>
          <th>悪用例</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="mono">U+200B</td>
          <td>ゼロ幅スペース (ZWS)</td>
          <td>コード・関数名・URL へ混入し、見た目を変えずテキストを分断</td>
        </tr>
        <tr>
          <td class="mono">U+200C / U+200D</td>
          <td>ZWNJ / ZWJ</td>
          <td>文字列の照合をすり抜けさせる改ざん</td>
        </tr>
        <tr>
          <td class="mono">U+202E ほか</td>
          <td>双方向制御 (RLO 等)</td>
          <td>表示順を逆転させ、文字列・ファイル名・URL を偽装</td>
        </tr>
        <tr>
          <td class="mono">U+FEFF</td>
          <td>BOM / ゼロ幅ノーブレーク</td>
          <td>先頭に混入させ構文チェックや比較を妨害</td>
        </tr>
        <tr>
          <td class="mono">U+2060</td>
          <td>ワードジョイナー (WJ)</td>
          <td>改行位置等を偽装</td>
        </tr>
      </tbody>
    </table>

    <div class="def">
      <p>
        <strong>対策の原則</strong>: 変換は「入力の忠実保持」であって検疫・検証ではありません。
        信頼できない .adoc を採用するときは、<span class="mono">不可視文字の走査</span>と<span class="mono">正規化</span>(例: <code>[\u200B-\u200D\u2060\uFEFF\u202A-\u202E]</code> を検出・除去)を行ってから利用してください。
      </p>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="section-title">テンプレートを入手</h2>
    <p style="max-width: 44rem">
      書き換えるだけで使える .adoc テンプレートです。(<code>&#123;&#123; プレースホルダ &#125;&#125;</code> を置き換え)
      AI に書かせるときも、この構造を保つだけで出力が安定します。
    </p>
    <div class="grid">
      <div class="card">
        <div class="icon">📄</div>
        <h3>汎用ドキュメント</h3>
        <p>背景・概要・詳細・まとめの定番構成。議事録や導入資料にも。</p>
        <p class="card-actions">
          <a class="btn btn-accent" href={link("/templates/document.adoc")} download>.adoc を入手</a>
        </p>
      </div>
      <div class="card">
        <div class="icon">🧩</div>
        <h3>機能仕様書 / PRD</h3>
        <p>ゴール・ユーザーストーリー・受け入れ条件まで、AI との仕様検討に最適。</p>
        <p class="card-actions">
          <a class="btn btn-accent" href={link("/templates/spec.adoc")} download>.adoc を入手</a>
        </p>
      </div>
      <div class="card">
        <div class="icon">📝</div>
        <h3>議事録</h3>
        <p>日時・参加者・アジェンダ・決定事項・残課題をテーブルと NOTE で整理。</p>
        <p class="card-actions">
          <a class="btn btn-accent" href={link("/templates/meeting-notes.adoc")} download>.adoc を入手</a>
        </p>
      </div>
      <div class="card">
        <div class="icon">🚀</div>
        <h3>リリースノート</h3>
        <p>新機能・変更・既知の問題を顧客にも AI にも読みやすく。</p>
        <p class="card-actions">
          <a class="btn btn-accent" href={link("/templates/release-notes.adoc")} download>.adoc を入手</a>
        </p>
      </div>
    </div>
    <p style="margin-top: 1.4rem; font-size: 0.9rem; color: #555">
      ※ 入手した .adoc は Playground に貼ればすぐ変換結果を確認できます。<a href={link("/playground")}>Playground を開く →</a>
    </p>
  </section>

  <section class="wrap section">
    <h2 class="section-title">はじめかた</h2>
    <ol class="steps">
      <li>「Playground」を開き、左のエディタに .adoc を書きます。</li>
      <li>右のプレビューに HTML 変換結果がリアルタイムに表示されます。</li>
      <li>「AsciiDoc を学ぶ」で書式の文法を確認します。</li>
    </ol>
    <p style="margin-top: 2rem">
      <a class="btn btn-paper" href={link("/playground")}>Playground を開く →</a>
    </p>
  </section>
</Layout>