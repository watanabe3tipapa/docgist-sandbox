---
import { link } from "../lib/link";

interface Props {
  title: string;
  description: string;
  lang?: "ja" | "en";
  locale?: "ja" | "en";
}

const { title, description, lang = "ja", locale = "ja" } = Astro.props;

const otherHref = locale === "ja" ? link("/en") : link("/");

const nav = link;
const data = locale === "ja" ? {
  rootHref: link("/"),
  whatIs: "AsciiDoc とは",
  playground: "Playground",
  switchLabel: "EN",
} : {
  rootHref: link("/en"),
  whatIs: "What is AsciiDoc",
  playground: "Playground",
  switchLabel: "日本語",
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" href={link("/favicon.ico")} />
    <title>{title}</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href={data.rootHref}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="4" y="4" width="16" height="16" fill="var(--accent)" stroke="#000" stroke-width="2" />
          <path d="M8 10h8M8 14h5" stroke="#000" stroke-width="2" stroke-linecap="round" />
        </svg>
        DocGist
      </a>
      <nav>
        <a href={nav("/what-is-asciidoc")}>{data.whatIs}</a>
        <a href={nav("/playground")}>{data.playground}</a>
        <a class="lang-switch" href={otherHref} aria-label={`Switch to ${data.switchLabel}`}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" />
            <path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.7-3.8-9s1.3-6.4 3.8-9z" stroke="currentColor" stroke-width="2" />
          </svg>
          {data.switchLabel}
        </a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>DocGist — AsciiDoc for humans and AI.</p>
      <p>© {new Date().getFullYear()} DocGist. Built with Astro + Asciidoctor.js.</p>
    </footer>
  </body>
</html>