---
interface Props {
  title: string;
  description: string;
  lang?: "ja" | "en";
  locale?: "ja" | "en";
}

const { title, description, lang = "ja", locale = "ja" } = Astro.props;

const otherLocale = locale === "ja" ? "en" : "ja";
const otherHref = locale === "ja" ? "/en" : "/";

const nav = {
  rootHref: locale === "ja" ? "/" : "/en",
  whatIsHref: locale === "ja" ? "/what-is-asciidoc" : "/en/what-is-asciidoc",
  playgroundHref: locale === "ja" ? "/playground" : "/en/playground",
};
const data = locale === "ja" ? {
  whatIs: "AsciiDoc とは",
  playground: "Playground",
  switchLabel: "EN",
} : {
  whatIs: "What is AsciiDoc",
  playground: "Playground",
  switchLabel: "日本語",
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href={nav.rootHref}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="4" y="4" width="16" height="16" fill="var(--accent)" stroke="#000" stroke-width="2" />
          <path d="M8 10h8M8 14h5" stroke="#000" stroke-width="2" stroke-linecap="round" />
        </svg>
        DocGist
      </a>
      <nav>
        <a href={nav.whatIsHref}>{data.whatIs}</a>
        <a href={nav.playgroundHref}>{data.playground}</a>
        <a class="lang-switch" href={otherHref}>{data.switchLabel}</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>DocGist — AsciiDoc for humans and AI.</p>
      <p>© {new Date().getFullYear()} DocGist. Built with Astro + Asciidoctor.js.</p>
    </footer>
  </body>
</html>